{
  "version": 1,
  "mode": "enforce",
  "meta": {
    "name": "Full feature policy — all rules active",
    "notes": "Cookie stripping, DNS blocking, body rewriting, consent enforcement all enabled. Filter list domains (EasyList) are automatically treated as advertising category."
  },
  "rules": {
    "tracker_set_cookie": {
      "enabled": true,
      "domains": [
        "google-analytics.com",
        "doubleclick.net",
        "facebook.com",
        "scorecardresearch.com",
        "adnxs.com",
        "connect.facebook.net",
        "googletagmanager.com",
        "googlesyndication.com",
        "facebook.net",
        "criteo.com",
        "criteo.net",
        "taboola.com",
        "outbrain.com",
        "amazon-adsystem.com",
        "adsrvr.org",
        "rubiconproject.com",
        "pubmatic.com",
        "casalemedia.com",
        "openx.net",
        "bidswitch.net",
        "demdex.net",
        "bluekai.com",
        "exelator.com",
        "quantserve.com",
        "mixpanel.com",
        "hotjar.com",
        "mouseflow.com",
        "fullstory.com",
        "clarity.ms",
        "newrelic.com",
        "sentry.io",
        "nr-data.net",
        "segment.io",
        "segment.com",
        "amplitude.com",
        "optimizely.com",
        "branch.io",
        "adjust.com",
        "appsflyer.com",
        "mparticle.com",
        "braze.com",
        "leanplum.com"
      ]
    },
    "dns_block": {
      "enabled": true,
      "domains": [
        "doubleclick.net",
        "google-analytics.com",
        "adnxs.com",
        "scorecardresearch.com",
        "connect.facebook.net",
        "googletagmanager.com",
        "googlesyndication.com",
        "criteo.com",
        "criteo.net",
        "taboola.com",
        "outbrain.com",
        "amazon-adsystem.com",
        "adsrvr.org",
        "rubiconproject.com",
        "pubmatic.com",
        "casalemedia.com",
        "openx.net",
        "bidswitch.net",
        "demdex.net",
        "bluekai.com",
        "exelator.com",
        "quantserve.com",
        "tracking.bp01.net",
        "ib.adnxs.com"
      ]
    },
    "body_rewrite": {
      "enabled": true,
      "tracker_script_patterns": [
        "google-analytics.com/analytics.js",
        "googletagmanager.com/gtm.js",
        "connect.facebook.net",
        "googlesyndication.com",
        "pagead2.googlesyndication.com",
        "securepubads.g.doubleclick.net",
        "adservice.google.com",
        "cdn.taboola.com",
        "cdn.outbrain.com",
        "static.criteo.net",
        "amazon-adsystem.com",
        "script.hotjar.com",
        "static.hotjar.com",
        "cdn.mxpnl.com",
        "cdn.segment.com",
        "cdn.amplitude.com",
        "static.clarity.ms",
        "cdn.piano.io",
        "cdn.tinypass.com",
        "js.pelcro.com",
        "cdn.ampproject.org/v0/amp-access",
        "meter.js"
      ],
      "remove_selectors": [
        "ins.adsbygoogle",
        "div[id^=\"google_ads\"]",
        "div[id^=\"div-gpt-ad\"]",
        "iframe[src*=\"doubleclick\"]",
        "iframe[src*=\"googlesyndication\"]",
        "div[class*='paywall']",
        "div[class*='Paywall']",
        "div[id*='paywall']",
        "div[id*='piano']",
        "div[class*='piano']",
        "div[id*='tp-modal']",
        "div[class*='tp-modal']",
        "div[class*='tp-backdrop']",
        "div[id*='premium-wall']",
        "div[class*='meter-']",
        "div[class*='subscribe-wall']",
        "div[class*='regwall']",
        "div[class*='ArticleGate']",
        "div[class*='article-gate']",
        "div[id*='offer-modal']",
        "div[class*='blueconic']",
        "div[class*='zephr']",
        "div[id*='zephr']",
        "div[class*='nag-bar']",
        "div[class*='overlay-paywall']",
        "div[class*='paywall-overlay']",
        "div[class*='paywall-served']",
        "div[id*='paywall-bg']",
        "div[class*='freestar']",
        "div[class*='modal-overlay']",
        "div[class*='subscriber-offer']",
        "div[class*='pw-']",
        "div[data-qa='overlay']",
        "div[class*='DrawerOverlay']",
        "div[class*='BottomDrawer']",
        "div[class*='interstitial']",
        "div[class*='Interstitial']"
      ],
      "css_inject_selectors": [
        "div#gateway-content",
        "iframe[name='__gateLocator']",
        "iframe[src*='regiwall']",
        "iframe[src*='auth/iframe']",
        "iframe[src*='onboarding-offer']",
        "iframe[src*='piano.io']",
        "iframe[src*='tinypass.com']",
        "iframe[src*='pelcro.com']",
        "iframe[src*='zephr']"
      ],
      "strip_tracking_pixels": true,
      "query_param_strip_enabled": true,
      "max_body_bytes": 2097152,
      "referer_spoof_domains": [
        "nytimes.com",
        "washingtonpost.com",
        "wsj.com",
        "ft.com",
        "theatlantic.com",
        "wired.com",
        "bloomberg.com",
        "businessinsider.com",
        "thetimes.co.uk",
        "telegraph.co.uk",
        "economist.com",
        "barrons.com",
        "hbr.org",
        "medium.com",
        "torontostar.com",
        "latimes.com",
        "bostonglobe.com",
        "seattletimes.com"
      ]
    },
    "consent_enforcement": {
      "enabled": true,
      "default_consent": "essential_only",
      "analytics_domains": [
        "google-analytics.com",
        "hotjar.com",
        "mixpanel.com",
        "fullstory.com",
        "mouseflow.com",
        "clarity.ms",
        "amplitude.com",
        "segment.com",
        "segment.io",
        "newrelic.com",
        "nr-data.net",
        "sentry.io",
        "optimizely.com"
      ],
      "site_overrides": {
      },
      "user_profiles": {
      }
    }
  }
}
