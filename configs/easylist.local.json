{
  "meta": {
    "name": "Portable local: MITM + DNS + EasyList + dashboard",
    "notes": "Portable loopback profile. DNS uses strict DoH and does not silently downgrade to UDP."
  },
  "listen_host": "127.0.0.1",
  "listen_port": 18081,
  "pinned_hosts_file": "state/pe_pinned_hosts.json",
  "never_intercept_hosts": [
    "api.anthropic.com",
    "api.github.com",
    "github.com",
    "localhost"
  ],
  "enable_mitm": true,
  "mitm_ca_cert_file": "certs/ca_cert.pem",
  "mitm_ca_key_file": "certs/ca_key.pem",
  "mitm_ca_generate_if_missing": true,
  "mitm_ca_export_cert_file": "certs/ca_cert_export.pem",
  "tls_profile": "chrome",
  "policy_config_file": "docs/policy_full.json",
  "policy_mode": "enforce",
  "policy_reload_interval_secs": 5,
  "enable_dns_filter": true,
  "dns_listen_host": "127.0.0.1",
  "dns_listen_port": 5353,
  "dns_upstream": "1.1.1.1:53",
  "dns_upstream_doh": "https://cloudflare-dns.com/dns-query",
  "dns_doh_failure_mode": "fail_closed",
  "dns_max_inflight": 128,
  "filter_list_file": ["state/easylist.txt"],
  "filter_list_cache_dir": "filter_list_cache",
  "filter_list_refresh_secs": 86400,
  "filter_list_download_timeout_secs": 30,
  "receipts_file": "state/pe_receipts.json",
  "receipts_flush_interval_secs": 5,
  "metrics_log_interval_secs": 30,
  "dashboard_port": 9090,
  "cert_log_file": "state/pe_cert_log.jsonl",
  "cert_pin_file": "state/pe_cert_pins.json",
  "force_http1_for_filter_rewrite": true
}
